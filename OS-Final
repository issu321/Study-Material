Program 15 – Payroll System

#!/bin/bash

DATA_FILE="employees.txt"

if [ -z "$1" ]; then
    echo "Usage: $0 <employee_id>"
    exit 1
fi

search_id=$1
found=0

if [ ! -s "$DATA_FILE" ]; then
    echo "No employee data found."
    exit 1
fi

while IFS=',' read -r emp_id name salary; do
    if [ "$emp_id" = "$search_id" ]; then
        hra=$((salary * 20 / 100))
        da=$((salary * 10 / 100))
        total=$((salary + hra + da))

        echo "Employee: $name"
        echo "Basic Salary: $salary"
        echo "HRA (20%): $hra"
        echo "DA (10%): $da"
        echo "Total Salary: $total"
        found=1
        break
    fi
done < "$DATA_FILE"

if [ $found -eq 0 ]; then
    echo "Employee ID not found."
fi


