Program 8 – List Files in Directory

#!/bin/bash

if [ -z "$1" ]; then
    echo "Usage: $0 <directory>"
    exit 1
fi

DIRECTORY=$1

if [ ! -d "$DIRECTORY" ]; then
    echo "Error: $DIRECTORY is not a valid directory."
    exit 1
fi

echo "Listing files in directory: $DIRECTORY"
for file in "$DIRECTORY"/*; do
    if [ -f "$file" ]; then
        echo "$(basename "$file")"
    fi
done


