Program 4 – Process Management

#!/bin/bash

echo "List of processes"
ps

echo "ppid pid command"
ps -eo pid,ppid,comm | column -t

echo "Shows terminal type"
tty

echo "Starting background process..."
sleep 60 &
PID=$!
echo "Background process started with PID $PID"

echo "Timing a sleep command for 3 seconds..."
time sleep 3

echo "Killing background process with PID $PID"
kill "$PID"


