Program 14 – Palindrome Check

#!/bin/bash

if [ $# -ne 1 ]; then
    echo "Usage: $0 string"
    exit 1
fi

str=$1
reversed=$(echo "$str" | rev)

if [ "$str" = "$reversed" ]; then
    echo "The string is a palindrome."
else
    echo "The string is not a palindrome."
fi


