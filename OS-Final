Program 3 – Directory & File Management

#!/bin/bash

echo "Current Directory:"
pwd

mkdir my_folder
echo "Directory 'my_folder' created."

cd my_folder || exit
echo "Changed to directory: $(pwd)"

echo "Enter some text (Ctrl+D to save):"
cat > sample.txt
echo "File 'sample.txt' created with content."

echo "Displaying contents of sample.txt:"
cat sample.txt

cp sample.txt copy_sample.txt
echo "File copied to 'copy_sample.txt'."

echo "Files in current directory:"
ls -l

mv copy_sample.txt renamed_sample.txt
echo "copy_sample.txt renamed to renamed_sample.txt."

chmod 644 renamed_sample.txt
echo "Permissions changed for renamed_sample.txt."

rm renamed_sample.txt
echo "renamed_sample.txt deleted."

echo "Current Directory:"
pwd

cd ..
rm -r my_folder
echo "'my_folder' and its contents removed."

echo "Script completed."


