Program 6 – Compare and Delete Duplicate

#!/bin/bash

if [ "$#" -ne 2 ]; then
    echo "Usage: $0 file1 file2"
    exit 1
fi

file1="$1"
file2="$2"

if [ ! -f "$file1" ] || [ ! -f "$file2" ]; then
    echo "Both files must exist."
    exit 1
fi

if cmp -s "$file1" "$file2"; then
    echo "Files are the same. Deleting $file2..."
    rm "$file2"
else
    echo "Files are different. No action taken."
fi


