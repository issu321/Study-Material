Program 7 – Count Words, Lines, Characters

#!/bin/bash

read -p "Enter the filename: " filename

if [ ! -f "$filename" ]; then
  echo "File does not exist."
  exit 1
fi

chars=$(wc -m < "$filename")
words=$(wc -w < "$filename")
lines=$(wc -l < "$filename")

echo "File: $filename"
echo "Characters: $chars"
echo "Words: $words"
echo "Lines: $lines"


